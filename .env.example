# Configuración de base de datos PostgreSQL
POSTGRES_PASSWORD=placeholder-postgres-password
DATABASE_URL=postgres://drive:placeholder-postgres-password@postgres:5432/drive

# LocalStack / AWS SDK (emulación local)
LOCALSTACK_AUTH_TOKEN=
AWS_ENDPOINT=http://localstack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=drive-files
SQS_QUEUE=drive-uploads
SQS_DLQ=drive-uploads-dlq
TEMP_DIR=/app/temp

# Sesiones y Seguridad (O04)
SESSION_SECRET=replace-with-a-random-secret-string-at-least-32-chars-long
COOKIE_SECURE=false
CORS_ORIGIN=http://127.0.0.1:8080
LOG_LEVEL=info
PORT=3000
