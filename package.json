{
  "name": "drive-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "contracts:generate": "node packages/contracts/scripts/generate.ts",
    "contracts:check": "node packages/contracts/scripts/generate.ts --check",
    "typecheck": "tsc --noEmit && npm run typecheck -w @drive-clone/server && npm run typecheck -w @drive-clone/web",
    "format:check": "sh scripts/format-check.sh",
    "lint": "eslint \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:coverage": "vitest run --exclude '**/*.integration.test.ts' --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --reporter=default --reporter=junit --outputFile.junit=reports/integration/junit.xml",
    "test:e2e": "scripts/test-e2e-isolated.sh",
    "test:e2e:repeat": "scripts/test-e2e-isolated.sh && scripts/test-e2e-isolated.sh",
    "check:file-lines": "sh scripts/check-file-lines.sh",
    "audit:dependencies": "mkdir -p reports && npm audit --audit-level=critical --json > reports/dependency-audit.json",
    "build": "npm run generate -w @drive-clone/server && npm run build -w @drive-clone/web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run contracts:check && npm run check:file-lines && npm test",
    "migrate": "npm run migrate -w @drive-clone/server",
    "bootstrap": "npm run bootstrap -w @drive-clone/server"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.15.0",
    "prettier": "3.6.2",
    "prettier-plugin-toml": "4.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "argon2@0.43.0": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
