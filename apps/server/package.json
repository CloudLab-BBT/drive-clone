{
  "name": "@drive-clone/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "node src/api.ts",
    "worker": "node src/worker.ts",
