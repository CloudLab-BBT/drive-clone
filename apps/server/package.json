{
  "name": "@drive-clone/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0 <25" },
  "scripts": {
    "dev": "node src/api.ts",
    "worker": "node src/worker.ts",
    "migrate": "prisma migrate deploy",
    "bootstrap": "node src/bootstrap.ts",
    "persistence:smoke": "node src/persistence-smoke.ts",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1171.0",
    "@aws-sdk/client-sqs": "3.1171.0",
    "@drive-clone/contracts": "1.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.8",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "@types/pg": "8.15.5"
  }
}
